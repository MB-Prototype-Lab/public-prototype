    "Debt payments": {
      "model": "debt",
      "col": "apply",
      "intro": "What leaves your account each month, not what you owe in total.",
      "questions": [
        { "id": "kinds", "type": "choice", "prompt": "What are you paying down?",
          "options": [
            { "id": "none",  "label": "Nothing right now" },
