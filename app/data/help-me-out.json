{
  "_note": "Help-me-out estimation trees. FIGURES live here with the source they came from; the ARITHMETIC lives in HMO_MODELS (js/help-me-out.js), because a rate table is data and multiplying it by a slider is logic. Questions ask about HABITS and never about dollars — people know how far they drive, not what they spend on petrol. Every figure is NATIONAL; hmoCompute applies the category's own cost-of-living multiplier on the way out, except where a tree is anchored on a peer figure that already carries it (col: included). Widen freely — this is data.",

  "trees": {

    "Transport": {
      "model": "transport",
      "col": "apply",
      "intro": "A car costs money before it moves, so this asks about both.",
      "questions": [
        { "id": "car", "type": "choice", "prompt": "Do you have a car?",
          "options": [
            { "id": "own",    "label": "Yes — I own or lease one" },
            { "id": "shared", "label": "I share one with someone" },
            { "id": "none",   "label": "No car" }
          ],
          "lifestyle": { "dim": "commute", "map": { "own": "car", "shared": "car", "none": "none" } } },

        { "id": "miles", "type": "slider", "prompt": "Roughly how far do you drive in a week?",
          "help": "A 20-minute local trip is about 8 miles. Guess high rather than low.",
          "showIf": { "q": "car", "is": ["own", "shared"] },
          "min": 0, "max": 500, "step": 10, "default": 100, "unit": "miles a week" },

        { "id": "vehicle", "type": "choice", "prompt": "What kind of car is it?",
          "showIf": { "q": "car", "is": ["own", "shared"] },
          "options": [
            { "id": "small",  "label": "Small car" },
            { "id": "midsize","label": "Midsize car" },
            { "id": "suv",    "label": "SUV or crossover" },
            { "id": "truck",  "label": "Truck or large SUV" },
            { "id": "hybrid", "label": "Hybrid" },
            { "id": "ev",     "label": "Electric" }
          ] },

        { "id": "transit", "type": "choice", "prompt": "Transit or rideshare on top of that?",
          "options": [
            { "id": "rarely",    "label": "Rarely" },
            { "id": "sometimes", "label": "Now and then" },
            { "id": "most",      "label": "Most days" }
          ] }
      ],
      "rates": {
        "_source": "AAA Your Driving Costs 2025. Operating cost = fuel + maintenance/tires per mile; insurance is annual full coverage / 12. EV and hybrid operating costs from the same report's alternative-powertrain rows.",
        "opCostPerMile":     { "small": 0.201, "midsize": 0.230, "suv": 0.235, "truck": 0.264, "hybrid": 0.170, "ev": 0.130 },
        "insuranceMonthly":  { "small": 126, "midsize": 131, "suv": 144, "truck": 153, "hybrid": 132, "ev": 150 },
        "_insuranceNote": "The line the old question set missed entirely. It is most of the category for a light driver — about $130 a month against roughly $19 of fuel and maintenance — which is how 'light local driving' came out at $10.",
        "transitMonthly":    { "rarely": 0, "sometimes": 55, "most": 130 },
        "sharedShare": 0.6
      }
    },

    "Subscriptions": {
      "model": "subscriptions",
      "col": "apply",
      "intro": "Tick what you pay for. The total is at the top as you go.",
      "questions": [
        { "id": "services", "type": "checklist", "prompt": "Which of these do you pay for?",
          "help": "Prices are the common plan for each. Adjust at the end if yours differs.",
          "options": [
            { "id": "netflix",   "label": "Netflix" },
            { "id": "hulu",      "label": "Hulu" },
            { "id": "disney",    "label": "Disney+" },
            { "id": "max",       "label": "HBO Max" },
            { "id": "prime",     "label": "Amazon Prime" },
            { "id": "appletv",   "label": "Apple TV+" },
            { "id": "paramount", "label": "Paramount+" },
            { "id": "peacock",   "label": "Peacock" },
            { "id": "youtubetv", "label": "YouTube TV" },
            { "id": "ytpremium", "label": "YouTube Premium" },
            { "id": "spotify",   "label": "Spotify" },
            { "id": "applemusic","label": "Apple Music" },
            { "id": "icloud",    "label": "iCloud or Google storage" },
            { "id": "news",      "label": "A news subscription" }
          ] },

        { "id": "others", "type": "slider", "prompt": "How many others do you have?",
          "help": "Apps, games, software, anything that bills monthly.",
          "min": 0, "max": 12, "step": 1, "default": 0, "unit": "more" }
      ],
      "rates": {
        "_source": "Published US list prices, September 2026. Ad-supported tier where one exists, since that is the commonly-held plan.",
        "services": {
          "netflix": 8.99, "hulu": 9.99, "disney": 9.99, "max": 9.99,
          "prime": 14.99, "appletv": 12.99, "paramount": 7.99, "peacock": 7.99,
          "youtubetv": 82.99, "ytpremium": 13.99, "spotify": 11.99,
          "applemusic": 10.99, "icloud": 2.99, "news": 25.00
        },
        "fallbackAverage": 12.00,
        "_flatNote": "Subscriptions are categoryBucket 'flat' in zip-cost-of-living.json, so the multiplier is 1.0 everywhere. A streaming plan costs the same in Palo Alto as in Helena."
      }
    },

    "Housing": {
      "model": "housing",
      "col": "included",
      "intro": "I know roughly what housing costs around your ZIP — this is about your place.",
      "questions": [
        { "id": "arrangement", "type": "choice", "prompt": "What's your setup?",
          "options": [
            { "id": "rent",   "label": "I rent" },
            { "id": "own",    "label": "I own — mortgage, tax and insurance" },
            { "id": "shared", "label": "I split it with someone" },
            { "id": "family", "label": "I live with family" }
          ],
          "lifestyle": { "dim": "paysRent",
                         "map": { "rent": "rent", "own": "mortgage", "shared": "other", "family": "family" } } },

        { "id": "bedrooms", "type": "choice", "prompt": "How big is the place?",
          "showIf": { "q": "arrangement", "is": ["rent", "own", "shared"] },
          "options": [
            { "id": "studio", "label": "Studio" },
            { "id": "one",    "label": "1 bedroom" },
            { "id": "two",    "label": "2 bedrooms" },
            { "id": "three",  "label": "3 bedrooms" },
            { "id": "four",   "label": "4 or more" }
          ] },

        { "id": "utilitiesIncluded", "type": "choice", "prompt": "Are any utilities included in what you pay?",
          "showIf": { "q": "arrangement", "is": ["rent", "shared"] },
          "options": [
            { "id": "no",  "label": "No — I pay them separately" },
            { "id": "yes", "label": "Yes — some or all are included" }
          ] }
      ],
      "rates": {
        "_source": "Anchored on benchPeerValue('Housing'), which already carries BEA Regional Price Parities for housing and the county's own rent ratio from Zillow ZORI. These are adjustments to that, so col is 'included' — applying the multiplier again would square it.",
        "arrangement": { "rent": 1.0, "own": 1.05, "shared": 0.6, "family": 0.22 },
        "_arrangementNote": "Matches PEER_BENCHMARKS.lifestyleModifiers.paysRent, which is the same claim made in the same units. Owning is a little above rent parity for tax and insurance.",
        "bedrooms": { "studio": 0.72, "one": 0.85, "two": 1.0, "three": 1.22, "four": 1.45 },
        "_bedroomsNote": "HUD Fair Market Rent ratios, normalised so a 2-bedroom is 1.0 — the size the peer base is built around.",
        "utilitiesIncluded": 1.12
      }
    },

    "Groceries": {
      "model": "groceries",
      "col": "apply",
      "intro": "I already know your household size, so this is about where and how you shop.",
      "questions": [
        { "id": "store", "type": "choice", "prompt": "Where do you do most of your shopping?",
          "options": [
            { "id": "warehouse", "label": "Warehouse club or discount grocer" },
            { "id": "standard",  "label": "A standard supermarket" },
            { "id": "premium",   "label": "Organic or specialty" }
          ],
          "lifestyle": { "dim": "foodie", "map": { "warehouse": "low", "standard": "moderate", "premium": "high" } } },

        { "id": "cooks", "type": "choice", "prompt": "How much of your eating happens at home?",
          "options": [
            { "id": "rarely",    "label": "Not much — most meals come from somewhere else" },
            { "id": "sometimes", "label": "About half and half" },
            { "id": "usually",   "label": "Most of it — I cook" }
          ],
          "lifestyle": { "dim": "cooksAtHome", "map": { "rarely": "rarely", "sometimes": "sometimes", "usually": "usually" } } }
      ],
      "rates": {
        "_source": "USDA Cost of Food at Home, 2026 monthly plans. Arrays are household size 1 / 2 / 3 / 4+. Warehouse maps to the Thrifty plan, standard to Low-Cost/Moderate, premium to Liberal.",
        "usdaMonthly": {
          "warehouse": [278, 610, 810, 1013],
          "standard":  [371, 700, 930, 1180],
          "premium":   [530, 980, 1310, 1668]
        },
        "cooks": { "rarely": 0.72, "sometimes": 1.0, "usually": 1.15 },
        "_cooksNote": "Cooking moves money BETWEEN groceries and dining out rather than creating it. The mirrored factors live in the Dining out tree."
      }
    },

    "Utilities": {
      "model": "utilities",
      "col": "included",
      "intro": "Power is the part that varies most by where you live, and I have your state's rate.",
      "questions": [
        { "id": "home", "type": "choice", "prompt": "What are you heating and cooling?",
          "options": [
            { "id": "studio", "label": "A studio" },
            { "id": "apt1",   "label": "A 1-bedroom" },
            { "id": "apt2",   "label": "A 2-bedroom" },
            { "id": "house2", "label": "A small house" },
            { "id": "house3", "label": "A 3-bedroom house" },
            { "id": "house4", "label": "A larger house" }
          ] },

        { "id": "included", "type": "choice", "prompt": "Is anything already covered in your rent?",
          "options": [
            { "id": "none", "label": "No — I pay for everything" },
            { "id": "some", "label": "Water or trash is covered" },
            { "id": "all",  "label": "Most of it is covered" }
          ] }
      ],
      "rates": {
        "_source": "EIA average US residential electricity price and typical consumption by dwelling size; published broadband and mobile averages. The rate here is NATIONAL on purpose: benchColLocalModifier already returns the state electricity ratio for Utilities, so hmoCompute's multiplier carries the local price. Applying it here as well squared it \u2014 Los Angeles was overstated by 65%.",
        "nationalCentsPerKwh": 16.5,
        "kwhByHome":   { "studio": 300, "apt1": 450, "apt2": 600, "house2": 850, "house3": 1050, "house4": 1300 },
        "waterByHome": { "studio": 30, "apt1": 40, "apt2": 55, "house2": 75, "house3": 90, "house4": 105 },
        "internet": 75,
        "phonePerLine": 40,
        "maxLines": 4
      }
    },

    "Health": {
      "model": "medical",
      "col": "apply",
      "intro": "Whether you pay a premium yourself changes this more than anything else.",
      "questions": [
        { "id": "premium", "type": "choice", "prompt": "How do you get your health cover?",
          "options": [
            { "id": "employer", "label": "Through work — it comes out of my pay" },
            { "id": "self",     "label": "I buy it myself" },
            { "id": "other",    "label": "Medicare, Medicaid, or I'm on someone else's" }
          ] },

        { "id": "visits", "type": "choice", "prompt": "How often do you see a doctor?",
          "options": [
            { "id": "rarely",   "label": "Almost never" },
            { "id": "few",      "label": "A couple of times a year" },
            { "id": "regular",  "label": "Every month or two" },
            { "id": "frequent", "label": "Regularly — something ongoing" }
          ] },

        { "id": "prescriptions", "type": "choice", "prompt": "Prescriptions?",
          "options": [
            { "id": "none",       "label": "None" },
            { "id": "occasional", "label": "Now and then" },
            { "id": "regular",    "label": "Something every month" },
            { "id": "several",    "label": "Several, every month" }
          ] },

        { "id": "dental", "type": "choice", "prompt": "Dental and eyes?",
          "options": [
            { "id": "none",      "label": "I don't go" },
            { "id": "cleanings", "label": "Cleanings and check-ups" },
            { "id": "work",      "label": "Ongoing work — braces, implants, glasses" }
          ] }
      ],
      "rates": {
        "_source": "KFF Employer Health Benefits Survey and Peterson-KFF: $869 a year average out-of-pocket for employer-covered adults, about $72 a month. Marketplace premium is the unsubsidised benchmark silver plan. MEPS for the prescription split.",
        "marketplacePremium": 480,
        "_premiumNote": "The branch the old three-bucket question could not express. Somebody buying their own cover is a different order of magnitude from somebody whose employer takes it from a paycheck, and averaging the two describes nobody.",
        "visitsMonthly":        { "rarely": 12, "few": 32, "regular": 85, "frequent": 175 },
        "prescriptionsMonthly": { "none": 0, "occasional": 14, "regular": 42, "several": 115 },
        "dentalMonthly":        { "none": 0, "cleanings": 22, "work": 68 }
      }
    },

    "Dining out": {
      "model": "dining",
