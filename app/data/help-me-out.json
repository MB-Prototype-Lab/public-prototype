            { "id": "typical", "label": "Some months" },
            { "id": "lots",    "label": "A fair amount" }
          ] }
      ],
      "rates": {
        "_source": "BLS Consumer Expenditure Survey cash contributions and miscellaneous, by income quintile; published average US leisure-trip cost.",
        "tripCost":     { "budget": 550, "typical": 1100, "comfortable": 2200 },
        "giftsMonthly": { "minimal": 15, "typical": 45, "generous": 110 },
