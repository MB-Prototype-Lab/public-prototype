          ] }
      ],
      "rates": {
        "_source": "BLS Consumer Expenditure Survey food-away-from-home, plus published average checks by service type (quick-serve, fast-casual, full-service). Per-week counts are converted at 52/12 weeks a month, not 4.",
        "coffeePerWeek": { "never": 0, "few": 2, "most": 4.5, "daily": 7 },
        "coffeePrice":   { "donut": 3.25, "chain": 5.50, "specialty": 6.75 },
        "lunchPerWeek":  { "never": 0, "occasional": 1.5, "few": 3.5, "most": 5 },
        "lunchPrice": 15.50,
        "dinnerPerWeek": { "never": 0, "occasional": 1, "few": 2.5, "most": 5 },
        "dinnerPrice":   { "casual": 22, "midrange": 35, "nice": 60 }
      }
    },

