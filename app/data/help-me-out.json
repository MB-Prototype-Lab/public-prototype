    "Other": {
      "model": "other",
      "col": "apply",
      "intro": "Trips are lumpy rather than monthly, so this works out what they come to across a year.",
      "questions": [
        { "id": "trips", "type": "slider", "prompt": "How many trips away do you take in a year?",
          "min": 0, "max": 12, "step": 1, "default": 2, "unit": "trips a year" },

        { "id": "tripStyle", "type": "choice", "prompt": "What does a typical one look like?",
          "showIf": { "q": "trips", "gt": 0 },
          "options": [
            { "id": "budget",      "label": "Cheap and cheerful" },
            { "id": "typical",     "label": "A normal holiday" },
            { "id": "comfortable", "label": "Comfortable — flights, decent hotels" }
          ],
          "lifestyle": { "dim": "travelFrequency",
                         "map": { "budget": "rare", "typical": "moderate", "comfortable": "frequent" } } },

        { "id": "gifts", "type": "choice", "prompt": "Presents and occasions?",
          "options": [
