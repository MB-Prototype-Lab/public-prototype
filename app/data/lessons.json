            "elements": [
              { "type": "icon", "name": "coin", "x": 50, "y": 22, "size": 18, "anim": "pop" },
              { "type": "label", "text": "APR", "x": 50, "y": 48, "size": 12, "anim": "rise" },
              {
                "type": "label",
                "text": "the yearly price of borrowing",
                "x": 50,
                "y": 60,
